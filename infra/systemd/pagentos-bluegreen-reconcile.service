# PagentOS Cloud Core: rebuild the blue/green state after a reboot, crash, or later
# health regression (M18.4 gap 2, ADR-0081 addendum 3, ADR-0118). Its persistent timer
# runs after boot and after each bounded interval, and calls
# release-cloud-core-bluegreen.sh --reconcile, which makes the last COMPLETED promotion
# canonical (marker, both edge upstreams, RELEASE, the tree) and drains and stops a
# half-promoted candidate - it never makes one live silently.
#
# The script and its digest live in the root-owned recovery root, outside every app tree
# a release swaps. A candidate cannot redefine the monitor that judges it. The env file
# and markers are under /opt/pagentos; the edge's upstream under /mnt/pagentos-data/edge.
#
# Install (root, after the candidate tree is released):
#   /opt/pagentos/app/scripts/cloud/install-recovery-supervisor.sh
#   journalctl -u pagentos-bluegreen-reconcile.service -n 30
[Unit]
Description=PagentOS Cloud Core blue/green reconcile (after boot or crash)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=no
TimeoutStartSec=600
Environment=PAGENTOS_BASE=/opt/pagentos
Environment=PAGENTOS_RECOVERY_BUNDLE=/opt/pagentos-recovery
ExecStartPre=/usr/bin/sha256sum --check /opt/pagentos-recovery/reconcile.sha256
ExecStart=/bin/bash /opt/pagentos-recovery/reconcile.sh --reconcile
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
