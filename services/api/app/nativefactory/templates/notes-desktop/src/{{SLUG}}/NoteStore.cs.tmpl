using System.IO;
using System.Text;
using System.Text.Json;

namespace {{NAMESPACE}};

/// <summary>
/// The notes, and the file they live in. Separated from the window ON PURPOSE: this is the
/// part with rules, so this is the part with tests, and a headless test run can prove the
/// persistence the owner will later verify by closing and reopening the window.
/// </summary>
public sealed class NoteStore
{
    private readonly string _path;
    private readonly List<string> _notes = new();

    public NoteStore(string path)
    {
        _path = path;
        Load();
    }

    /// <summary>
    /// Where a store keeps its notes when the application does not say.
    /// </summary>
    /// <remarks>
    /// A <c>data</c> directory beside the executable is preferred, and for an application
    /// this factory produced that is inside the owner's authorised roots - which is what
    /// lets the system that built it read its log back afterwards (M28 spec §5). An
    /// application installed somewhere read-only, as a real one under Program Files would
    /// be, falls back to LocalApplicationData. The same code is correct in both places.
    /// </remarks>
    public static string DefaultPath() => Path.Combine(DataDirectory(), "notes.json");

    /// <summary>The directory this application keeps everything of its own in.</summary>
    public static string DataDirectory()
    {
        var beside = Path.Combine(AppContext.BaseDirectory, "data");
        try
        {
            Directory.CreateDirectory(beside);
            // Prove it is writable rather than assuming: a directory can be created and
            // still refuse a file, which is exactly the case this fallback exists for.
            var probe = Path.Combine(beside, ".writable");
            File.WriteAllText(probe, string.Empty);
            File.Delete(probe);
            return beside;
        }
        catch (Exception)
        {
            var fallback = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "{{SLUG}}");
            Directory.CreateDirectory(fallback);
            return fallback;
        }
    }

    public IReadOnlyList<string> Notes => _notes;

    /// <summary>Add one note. Blank is not a note; a duplicate is allowed (people repeat).</summary>
    public bool Add(string text)
    {
        var trimmed = (text ?? string.Empty).Trim();
        if (trimmed.Length == 0)
        {
            return false;
        }

        _notes.Add(trimmed);
        Save();
        return true;
    }

    public bool RemoveAt(int index)
    {
        if (index < 0 || index >= _notes.Count)
        {
            return false;
        }

        _notes.RemoveAt(index);
        Save();
        return true;
    }

    private void Load()
    {
        if (!File.Exists(_path))
        {
            return;
        }

        try
        {
            var json = File.ReadAllText(_path, Encoding.UTF8);
            var loaded = JsonSerializer.Deserialize<List<string>>(json);
            if (loaded is not null)
            {
                _notes.AddRange(loaded);
            }
        }
        catch (Exception)
        {
            // A corrupt store is not a crash: the owner keeps a working application and
            // loses the unreadable file's contents, which is the better of the two.
        }
    }

    private void Save()
    {
        var directory = Path.GetDirectoryName(_path);
        if (!string.IsNullOrEmpty(directory))
        {
            Directory.CreateDirectory(directory);
        }

        File.WriteAllText(_path, JsonSerializer.Serialize(_notes), Encoding.UTF8);
    }
}
