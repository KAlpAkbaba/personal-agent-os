<Window x:Class="{{NAMESPACE}}.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{{TITLE}}" Height="420" Width="560"
        AutomationProperties.AutomationId="MainWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddButton"
                    DockPanel.Dock="Right"
                    Width="96" Margin="8,0,0,0"
                    Content="Ekle"
                    AutomationProperties.AutomationId="AddButton"
                    AutomationProperties.Name="Not ekle"
                    Click="AddButton_Click" />
            <TextBox x:Name="NoteInput"
                     AutomationProperties.AutomationId="NoteInput"
                     AutomationProperties.Name="Not metni"
                     VerticalContentAlignment="Center"
                     Padding="6,4" />
        </DockPanel>

        <ListBox x:Name="NoteList" Grid.Row="1"
                 AutomationProperties.AutomationId="NoteList"
                 AutomationProperties.Name="Notlar" />

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left"
                       AutomationProperties.AutomationId="StatusText"
                       VerticalAlignment="Center" />
            <Button x:Name="DeleteButton"
                    DockPanel.Dock="Right"
                    Width="96"
                    Content="Sil"
                    AutomationProperties.AutomationId="DeleteButton"
                    AutomationProperties.Name="Secili notu sil"
                    Click="DeleteButton_Click" />
        </DockPanel>
    </Grid>
</Window>
