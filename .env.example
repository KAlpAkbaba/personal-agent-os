# Personal Agent OS — development environment template.
#
# Copy to .env (gitignored) and adjust as needed. Every value below is a
# DEV-ONLY default that matches infra/docker/docker-compose.dev.yml, which
# binds all services to 127.0.0.1 on this machine. None of these are real
# secrets; production credentials must NEVER be committed and are provisioned
# outside the repository.
#
# The API service (services/api) reads these with the PAGENTOS_ prefix via
# pydantic-settings; unset values fall back to identical in-code defaults.

# --- PostgreSQL 16 + pgvector (compose service: postgres, host port 15432) ---
PAGENTOS_DATABASE_URL=postgresql+psycopg://pagentos:pagentos-dev@127.0.0.1:15432/pagentos

# --- Redis 7 (compose service: redis, host port 16379) ---
PAGENTOS_REDIS_URL=redis://127.0.0.1:16379/0

# --- MinIO S3-compatible object store (compose service: minio) ---
# S3 API: http://127.0.0.1:19000  |  Console UI: http://127.0.0.1:19001
# minioadmin/minioadmin are the dev-only MinIO defaults for the local
# loopback container. Do not reuse them anywhere else.
PAGENTOS_S3_ENDPOINT_URL=http://127.0.0.1:19000
PAGENTOS_S3_ACCESS_KEY=minioadmin
PAGENTOS_S3_SECRET_KEY=minioadmin
PAGENTOS_S3_BUCKET=pagentos-artifacts
PAGENTOS_S3_REGION=us-east-1

# --- Temporal dev server (compose service: temporal) ---
# gRPC frontend: 127.0.0.1:17233  |  Web UI: http://127.0.0.1:18233
PAGENTOS_TEMPORAL_ADDRESS=127.0.0.1:17233
PAGENTOS_TEMPORAL_NAMESPACE=default
PAGENTOS_TEMPORAL_TASK_QUEUE=pagentos-core

# --- Service behavior ---
PAGENTOS_ENVIRONMENT=dev
PAGENTOS_HEALTH_CHECK_TIMEOUT_S=2.0

# CORS allowlist of browser web origins permitted to call the API. Loopback
# dev origins by default; NEVER "*". In production set this to the real
# (Tailscale/private) web origin. JSON array form when overriding via env:
# PAGENTOS_WEB_ORIGINS=["https://pagentos.example"]
