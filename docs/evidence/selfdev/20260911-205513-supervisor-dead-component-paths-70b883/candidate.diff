diff --git a/services/api/tests/unit/test_evolution_supervisor_component_paths.py b/services/api/tests/unit/test_evolution_supervisor_component_paths.py
new file mode 100644
index 0000000..739e4d1
--- /dev/null
+++ b/services/api/tests/unit/test_evolution_supervisor_component_paths.py
@@ -0,0 +1,55 @@
+"""The supervisor's component map must name real places (defect: dead component paths).
+
+``paths_for_component()`` feeds ``derive_risk_tier()`` and ``promotion_class_for()``: a path
+that exists nowhere silently misses the risk table's rules. So every mapped path must either
+exist in the repository or lie under a declared runtime-generated root - and the declared
+roots must themselves be real directories, so "declare a root" is not a way out of the check.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from app.evolution import supervisor
+
+
+def _repo_root() -> Path:
+    """The repository root, walked up from the module under test."""
+    for candidate in Path(supervisor.__file__).resolve().parents:
+        if (candidate / ".git").exists() or (candidate / "services" / "api").is_dir():
+            return candidate
+    raise AssertionError("repository root not found from app.evolution.supervisor")
+
+
+def test_declared_runtime_generated_roots_are_real_directories() -> None:
+    root = _repo_root()
+    missing = [r for r in supervisor._RUNTIME_GENERATED_ROOTS if not (root / r).is_dir()]
+    assert not missing, f"declared runtime-generated roots are not directories: {missing}"
+
+
+def test_every_mapped_component_path_is_real_or_runtime_generated() -> None:
+    root = _repo_root()
+    dead: list[tuple[str, str]] = []
+    for component, paths in supervisor._COMPONENT_PATHS.items():
+        for path in paths:
+            if (root / path).exists():
+                continue
+            if any(path.startswith(r) for r in supervisor._RUNTIME_GENERATED_ROOTS):
+                continue
+            dead.append((component, path))
+    assert not dead, f"component paths that exist nowhere: {dead}"
+
+
+def test_windows_agent_is_never_auto_promote() -> None:
+    promotion, tier, _reasons = supervisor.promotion_class_for(
+        supervisor.paths_for_component("windows-agent")
+    )
+    assert (promotion, tier) == (supervisor.PROMOTION_NEVER_AUTO_PROMOTE, 4)
+
+
+def test_browser_worker_and_generated_skill_keep_their_tier() -> None:
+    for component in ("browser-worker", "generated_skill"):
+        promotion, tier, _reasons = supervisor.promotion_class_for(
+            supervisor.paths_for_component(component)
+        )
+        assert (promotion, tier) == (supervisor.PROMOTION_AUTO_CANARY, 2), component
