# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
secrets/local/

# Python
.venv/
__pycache__/
# fpdf2 font cache written next to bundled .ttf files
services/api/app/artifacts/fonts/*.pkl
*.pyc
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/
dist/
coverage/

# .NET
bin/
obj/
.vs/

# IDE/OS
.DS_Store
Thumbs.db
.idea/
.vscode/*.local.json

# Claude local settings/transcripts
.claude/settings.local.json

# Owner identity root (M9): holds the SHA-256 hash of the single owner
# credential. Machine-local by design (constitution §6 identity root) and never
# tracked — see services/api/app/identity/root.py.
services/api/var/

# Runtime
artifacts/local/
data/local/
logs/
*.log

# Generated environment report may contain machine details
# Keep it local unless owner explicitly wants it committed.
docs/LOCAL_ENV_REPORT.generated.json

# Evolution Engine (M7): generated-skill runtime output. Published skill
# versions and disposable candidate workspaces are machine-produced artifacts
# tracked in the skill_versions table (with manifest digests), not source.
skills/generated/*
!skills/generated/README.md

# OpenTofu/Terraform: state can contain sensitive attribute values, and .tfvars holds
# the tokens themselves. Neither belongs in git.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
