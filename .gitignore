# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
secrets/local/

# Python
.venv/
__pycache__/
# fpdf2 font cache written next to bundled .ttf files
services/api/app/artifacts/fonts/*.pkl
*.pyc
.pytest_cache/
.ruff_cache/

# Node
node_modules/
.next/
dist/
coverage/

# El hareketi kumandası (ADR-0198, Stage 1): the MediaPipe WASM runtime and the
# hand_landmarker model, fetched by apps/web/scripts/fetch-mediapipe-assets.mjs
# ("pnpm run fetch:mediapipe" from apps/web) — a local copy of node_modules and a
# pinned download, never source. tracker.ts fails closed with a Turkish message
# when this directory is missing.
apps/web/public/mediapipe/

# .NET
bin/
obj/
.vs/

# IDE/OS
.DS_Store
Thumbs.db
.idea/
.vscode/*.local.json

# Claude local settings/transcripts
.claude/settings.local.json

# Owner identity root (M9): holds the SHA-256 hash of the single owner
# credential. Machine-local by design (constitution §6 identity root) and never
# tracked — see services/api/app/identity/root.py.
services/api/var/

# Runtime
artifacts/local/
data/local/
logs/
*.log

# Generated environment report may contain machine details
# Keep it local unless owner explicitly wants it committed.
docs/LOCAL_ENV_REPORT.generated.json

# Evolution Engine (M7): generated-skill runtime output. Published skill
# versions and disposable candidate workspaces are machine-produced artifacts
# tracked in the skill_versions table (with manifest digests), not source.
skills/generated/*
!skills/generated/README.md

# OpenTofu/Terraform: state can contain sensitive attribute values, and .tfvars holds
# the tokens themselves. Neither belongs in git.
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# A SAVED PLAN embeds the variable values it was planned with - including the Tailscale
# auth key - so tfplan.binary is secret-bearing at rest exactly like state is. It was one
# `git add -A` away from being committed.
tfplan.binary
*.tfplan

# .terraform.lock.hcl is deliberately NOT ignored. It holds no secret — it pins the
# provider VERSION and its cryptographic hashes, which is the same supply-chain control
# M7 applies to generated skills (pinned dependencies with digests). Ignoring it would
# let a later `tofu init` satisfy `~> 1.51` with a different provider build than the one
# reviewed here, on the machine that provisions real infrastructure.

# Agent worktrees are scratch checkouts of this repo; committing them would nest the repo inside itself.
.claude/worktrees/

# TypeScript incremental state (tsc --noEmit)
*.tsbuildinfo

# Owner qualification run evidence written by scripts\browser\real-browser-smoke.ps1 and
# scripts\research\owner-research.ps1 (-OutFile). These are records of a run on the owner's
# machine, not source: committing them would also make every qualification dirty the tree and
# block the next Cloud Core release (2026-09-04).
/research-*.json
/browser-*.json
/explain-*.json

# Generated by `next dev` / `next build` on every start (the two write different import
# paths, so whichever form is committed is dirtied by the other): never tracked. tsc passes
# without it (verified 2026-09-06); next regenerates it before it needs it.
apps/web/next-env.d.ts
# Next 16 writes agent-rule notes into the app on `next dev`; not this repository's docs.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# The nightly Owner Utterance Suite report (scripts\core\voice-routing-qualification.ps1)
# and the loopback proxy's input: a run record with every case's speech, kept as a CI
# artifact and posted to the Cloud Core, never source (2026-09-07).
/state/reports/
