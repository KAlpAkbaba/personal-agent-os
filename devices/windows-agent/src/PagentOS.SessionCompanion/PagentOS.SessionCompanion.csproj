<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      B48 (device camera, ADR proposed in WORKLOG_B48.md): the Windows SDK version in the
      target framework is what brings the WinRT projection (Windows.Media.Capture,
      Windows.Media.FaceAnalysis) into this process - on-device, no account, shipped with
      Windows. The build output stays in bin\<Configuration>\net10.0-windows\ so every script
      that already names that folder keeps working; only this project and the two test
      projects that reference it carry the SDK version (a lower-versioned project cannot
      reference a higher one).
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <OutputType>Exe</OutputType>
    <RootNamespace>PagentOS.SessionCompanion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      M19 (M19_DIGITAL_OPERATOR_SPEC.md §3): System.Windows.Automation for the ui.* family. The
      WPF profile of the Windows Desktop framework is where UIAutomationClient/UIAutomationTypes
      live; referencing the profile directly keeps the process console-only (no UseWPF, no
      generated App entry point, no XAML tooling).
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <!--
      B11 (requirement 369): desktop.notify needs a shell notification, and NotifyIcon lives
      in the WindowsForms profile. Profile reference rather than UseWindowsForms: the process
      stays console-only, with no generated entry point and no designer tooling.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!--
      M20 (ADR-0083, docs/THIRD_PARTY_COMPONENTS.md): the two document parsers behind the
      Documents/ provider interfaces. Pinned; DOCX/XLSX/PPTX parts are read through the SDK
      only (no manual zip walking), PDFs through PdfPig's page text extractor.
    -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PagentOS.Agent.Core\PagentOS.Agent.Core.csproj" />
    <ProjectReference Include="..\PagentOS.Companion.Audio\PagentOS.Companion.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
